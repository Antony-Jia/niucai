# Generate independent random secrets: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
NIUCAI_API_TOKEN=
NIUCAI_OPENROUTER_API_KEY=
NIUCAI_DOMAIN=agent.example.com
NIUCAI_RUNTIME=deepagents
# disabled until Computer Runtime is configured; never mistake fake output for a real device.
NIUCAI_ADAPTER=disabled
NIUCAI_ALLOW_SHELL=false
# Private Docker network address only. Do not expose port 9222 to the Internet.
NIUCAI_BROWSER_CDP_URL=http://computer:9222
NIUCAI_LEASE_SECONDS=90
NIUCAI_ACTION_TIMEOUT=30

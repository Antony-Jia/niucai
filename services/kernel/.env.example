NIUCAI_DATABASE_URL=sqlite:///./niucai.db
NIUCAI_API_TOKEN=
NIUCAI_OPENROUTER_API_KEY=
NIUCAI_RUNTIME=deepagents
NIUCAI_MODEL_CONFIG_PATH=models.yaml
NIUCAI_ADAPTER=disabled
NIUCAI_WORKSPACE=./workspace
NIUCAI_ALLOW_SHELL=false

# Android PWA: HTTPS required in production. Disable secure cookies ONLY for localhost development.
NIUCAI_COOKIE_SECURE=true
# Optional: configure after the persistent Computer Runtime is ready.
NIUCAI_COMPUTER_WEB_ID=
NIUCAI_COMPUTER_WEB_URL=/computer/vnc.html
# Private origin only, e.g. http://computer:6901. Never publish this port.
NIUCAI_COMPUTER_WEB_UPSTREAM=
NIUCAI_COMPUTER_WEB_USER=
NIUCAI_COMPUTER_WEB_PASSWORD=
